{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/register.php",
      "dest": "/api/register.php"
    },
    {
      "src": "/api/referral.php",
      "dest": "/api/referral.php"
    },
    {
      "src": "/api/analytics.php",
      "dest": "/api/analytics.php"
    },
    {
      "src": "/api/experiments.php",
      "dest": "/api/experiments.php"
    },
    {
      "src": "/api/admin_actions.php",
      "dest": "/api/admin_actions.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
